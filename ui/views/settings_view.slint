import { Theme } from "../Theme.slint";
import { ScrollView, Button } from "std-widgets.slint";
import { CustomToggle } from "../components/base/custom_toggle.slint";
import { CustomButton } from "../components/base/custom_button.slint";

export component SettingsView inherits Rectangle {
    in property <bool> is-mobile;
    in-out property <bool> sync-enabled: true;
    in-out property <bool> dark-theme: true;
    callback pair-device-clicked();

    VerticalLayout {
        padding: Theme.padding-normal;
        spacing: 16px;

        Text {
            text: "⚙️ 設定";
            font-family: Theme.font-family;
            font-size: 24px;
            font-weight: 700;
            color: Theme.text;
        }

        ScrollView {
            VerticalLayout {
                spacing: 20px;

                VerticalLayout {
                    spacing: 10px;
                    Text { text: "表示設定"; color: Theme.primary; font-family: Theme.font-family; font-size: 14px; font-weight: 700; }
                    
                    CustomToggle {
                        label: "ダークテーマを使用";
                        checked: root.dark-theme;
                        toggled(val) => { root.dark-theme = val; }
                    }
                }

                VerticalLayout {
                    spacing: 10px;
                    Text { text: "同期と接続"; color: Theme.primary; font-family: Theme.font-family; font-size: 14px; font-weight: 700; }
                    
                    CustomToggle {
                        label: "P2P同期を有効にする";
                        checked: root.sync-enabled;
                        toggled(val) => { root.sync-enabled = val; }
                    }

                    if (root.sync-enabled) : Rectangle {
                        background: Theme.card-bg;
                        border-radius: Theme.border-radius-card;
                        border-width: 1px;
                        border-color: Theme.border-color;
                        height: 120px;

                        VerticalLayout {
                            padding: Theme.padding-normal;
                            spacing: 10px;

                            Text {
                                text: "接続済みのデバイス:";
                                color: Theme.text;
                                font-family: Theme.font-family;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            Text {
                                text: "• sumir-phone (Android) - 同期済み";
                                color: Theme.text-sub;
                                font-family: Theme.font-family;
                                font-size: 12px;
                            }

                            Rectangle {}

                            CustomButton {
                                text: "新しいデバイスとペアリング";
                                bg-color: Theme.primary;
                                hover-color: Theme.primary-hover;
                                clicked => { root.pair-device-clicked(); }
                                height: 32px;
                            }
                        }
                    }
                }
            }
        }
    }
}
