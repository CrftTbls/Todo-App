import { Theme } from "../Theme.slint";
import { ScrollView, Button } from "std-widgets.slint";
import { CustomButton } from "../components/base/custom_button.slint";

export component TrashView inherits Rectangle {
    in property <bool> is-mobile;
    callback restore-clicked(string);
    callback delete-permanent-clicked(string);

    VerticalLayout {
        padding: Theme.padding-normal;
        spacing: 16px;

        HorizontalLayout {
            height: 40px;
            Text {
                text: "🗑️ キャンセル・保留したタスク";
                font-family: Theme.font-family;
                font-size: 20px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            Rectangle {}
            CustomButton {
                text: "ゴミ箱を空にする";
                bg-color: Theme.danger;
                hover-color: Theme.danger;
                clicked => { root.delete-permanent-clicked("all"); }
                height: 32px;
            }
        }

        ScrollView {
            VerticalLayout {
                spacing: 12px;

                Rectangle {
                    height: 56px;
                    background: Theme.card-bg;
                    border-radius: Theme.border-radius-card;
                    border-width: 1px;
                    border-color: Theme.border-color;

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        alignment: space-between;

                        Text {
                            text: "古いメモの整理";
                            color: Theme.text-sub;
                            font-family: Theme.font-family;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            CustomButton {
                                text: "元に戻す";
                                bg-color: Theme.primary;
                                clicked => { root.restore-clicked("1"); }
                                height: 32px;
                            }
                            CustomButton {
                                text: "削除";
                                bg-color: Theme.background;
                                clicked => { root.delete-permanent-clicked("1"); }
                                height: 32px;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 56px;
                    background: Theme.card-bg;
                    border-radius: Theme.border-radius-card;
                    border-width: 1px;
                    border-color: Theme.border-color;

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        alignment: space-between;

                        Text {
                            text: "不要になったタスクテスト";
                            color: Theme.text-sub;
                            font-family: Theme.font-family;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            CustomButton {
                                text: "元に戻す";
                                bg-color: Theme.primary;
                                clicked => { root.restore-clicked("2"); }
                                height: 32px;
                            }
                            CustomButton {
                                text: "削除";
                                bg-color: Theme.background;
                                clicked => { root.delete-permanent-clicked("2"); }
                                height: 32px;
                            }
                        }
                    }
                }
            }
        }
    }
}
