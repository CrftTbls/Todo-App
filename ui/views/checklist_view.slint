import { Theme } from "../Theme.slint";
import { ScrollView, Button } from "std-widgets.slint";
import { CustomCheckbox } from "../components/base/custom_checkbox.slint";

export component ChecklistView inherits Rectangle {
    in property <bool> is-mobile;
    callback back-clicked();

    VerticalLayout {
        padding: Theme.padding-normal;
        spacing: 16px;
        
        HorizontalLayout {
            height: 40px;
            spacing: 10px;
            Button { 
                text: "✕ 戻る"; 
                clicked => { root.back-clicked(); }
            }
            Rectangle {}
            Text {
                text: "🎒 旅行の持ち物";
                font-family: Theme.font-family;
                font-size: 20px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            Rectangle {}
        }
        
        Rectangle {
            background: Theme.card-bg;
            border-radius: 8px;
            height: 42px;
            
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: "⏰ 毎日 07:00 にリマインド";
                    color: Theme.text-sub;
                    font-family: Theme.font-family;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
        }
        
        ScrollView {
            VerticalLayout {
                spacing: 12px;
                
                CustomCheckbox {
                    label: "航空券・ホテルの予約確認書";
                }
                CustomCheckbox {
                    label: "パスポート / 免許証 / マイナンバーカード";
                }
                CustomCheckbox {
                    label: "スマートフォン充電器・モバイルバッテリー";
                }
                CustomCheckbox {
                    label: "着替え・常備薬・洗面用具";
                }
            }
        }
    }
}
