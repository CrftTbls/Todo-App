import { Theme } from "../Theme.slint";
import { ViewHeader } from "../components/modules/view_header.slint";
import { BentoCard } from "../components/base/bento_card.slint";
import { InnerPanel } from "../components/base/inner_panel.slint";
import { CustomButton } from "../components/base/custom_button.slint";
import { Badge } from "../components/base/badge.slint";

export component MemoStockView inherits Rectangle {
    callback select-memo(string);
    callback create-memo();

    background: transparent;
    vertical-stretch: 1;
    
    VerticalLayout {
        spacing: Theme.spacing-view;
        vertical-stretch: 1;
        
        // Header Row (Pencil D3 Spec)
        HorizontalLayout {
            alignment: space-between;
            vertical-stretch: 0;
            
            HorizontalLayout {
                spacing: Theme.spacing-item;
                alignment: start;
                
                Text {
                    text: "思考メモ一覧";
                    font-family: Theme.font-family;
                    font-size: Theme.font-size-header;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                
                Badge {
                    text: "カードを選択してモーダルで詳細確認・編集";
                    badge-bg: Theme.primary-alpha;
                    badge-text-color: Theme.primary-light;
                }
            }
        }
        
        // Filter & Search Bar Row
        BentoCard {
            vertical-stretch: 0;
            
            HorizontalLayout {
                spacing: Theme.spacing-view;
                alignment: space-between;
                
                // Search Mock
                Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    background: Theme.panel-bg-dark;
                    border-radius: Theme.border-radius-small;
                    border-color: Theme.card-stroke;
                    border-width: Theme.stroke-normal;
                    
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        
                        Text {
                            text: "🔍 メモの検索・タグフィルター...";
                            font-family: Theme.font-family;
                            font-size: Theme.font-size-small;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }
                }
                
                // Tag Filter Buttons Group
                HorizontalLayout {
                    spacing: Theme.spacing-small;
                    
                    CustomButton {
                        text: "すべて (3)";
                        variant: "primary";
                    }
                    CustomButton {
                        text: "#仕事";
                        variant: "dark";
                    }
                    CustomButton {
                        text: "#UI改善";
                        variant: "dark";
                    }
                    CustomButton {
                        text: "#設計";
                        variant: "dark";
                    }
                }
            }
        }
        
        // Memo Cards Grid (Pencil D3 3-Card Layout)
        HorizontalLayout {
            spacing: Theme.spacing-view;
            vertical-stretch: 1;
            
            // MemoCard 1 (with AI Task Badge)
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                
                TouchArea {
                    clicked => { root.select-memo("1"); }
                }
                
                BentoCard {
                    vertical-stretch: 1;
                    has-highlight: true;
                    
                    VerticalLayout {
                        spacing: Theme.spacing-panel;
                        vertical-stretch: 1;
                        
                        HorizontalLayout {
                            alignment: space-between;
                            
                            Text {
                                text: "💡 UIデザイン改善アイデアメモ";
                                font-family: Theme.font-family;
                                font-size: 16px;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            
                            Badge {
                                text: "⚡ AI検出タスク: 1件あり";
                                badge-bg: Theme.success-alpha;
                                badge-text-color: Theme.success;
                                is-bold: true;
                            }
                        }
                        
                        InnerPanel {
                            panel-bg: Theme.panel-bg-dark;
                            padding-val: Theme.padding-normal;
                            vertical-stretch: 1;
                            
                            Text {
                                text: "日常の業務の中で思いついた改善案をここにリストアップしておく。\n\n- [ ] 明日15時にプロトタイプUIのレビューを行う @仕事 !高\n- [x] Bento Box風レイアウトへ刷新";
                                font-family: Theme.font-family;
                                font-size: Theme.font-size-small;
                                color: Theme.text-sub;
                                wrap: word-wrap;
                            }
                        }
                        
                        Text {
                            text: "#仕事 #UI改善 (1クリックで閲覧・編集モーダル表示)";
                            font-family: Theme.font-family;
                            font-size: Theme.font-size-small;
                            color: Theme.primary-light;
                        }
                    }
                }
            }
            
            // MemoCard 2
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                
                TouchArea {
                    clicked => { root.select-memo("2"); }
                }
                
                BentoCard {
                    vertical-stretch: 1;
                    
                    VerticalLayout {
                        spacing: Theme.spacing-panel;
                        vertical-stretch: 1;
                        
                        Text {
                            text: "📝 システム秘書構想ノート";
                            font-family: Theme.font-family;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        
                        InnerPanel {
                            panel-bg: Theme.panel-bg-dark;
                            padding-val: Theme.padding-normal;
                            vertical-stretch: 1;
                            
                            Text {
                                text: "喋らないAI秘書のバックエンドアーキテクチャ設計。P2P同期とローカルSLM解析の統合プロトコルについてのメモ...";
                                font-family: Theme.font-family;
                                font-size: Theme.font-size-small;
                                color: Theme.text-sub;
                                wrap: word-wrap;
                            }
                        }
                        
                        Text {
                            text: "#設計 #アーキテクチャ (1クリックで閲覧・編集モーダル表示)";
                            font-family: Theme.font-family;
                            font-size: Theme.font-size-small;
                            color: Theme.text-sub;
                        }
                    }
                }
            }
            
            // MemoCard 3
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                
                TouchArea {
                    clicked => { root.select-memo("3"); }
                }
                
                BentoCard {
                    vertical-stretch: 1;
                    
                    VerticalLayout {
                        spacing: Theme.spacing-panel;
                        vertical-stretch: 1;
                        
                        Text {
                            text: "⚙️ ローカルSQLite DB最適化計画";
                            font-family: Theme.font-family;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        
                        InnerPanel {
                            panel-bg: Theme.panel-bg-dark;
                            padding-val: Theme.padding-normal;
                            vertical-stretch: 1;
                            
                            Text {
                                text: "CRDTによる衝突なし自動マージとLWW(Last-Write-Wins)アルゴリズムの適用検証結果およびパフォーマンス計測結果...";
                                font-family: Theme.font-family;
                                font-size: Theme.font-size-small;
                                color: Theme.text-sub;
                                wrap: word-wrap;
                            }
                        }
                        
                        Text {
                            text: "#DB #同期 (1クリックで閲覧・編集モーダル表示)";
                            font-family: Theme.font-family;
                            font-size: Theme.font-size-small;
                            color: Theme.text-sub;
                        }
                    }
                }
            }
        }
    }
}
