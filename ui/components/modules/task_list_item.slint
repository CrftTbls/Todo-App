import { CustomCheckbox } from "../base/custom_checkbox.slint";
import { Theme } from "../../Theme.slint";

export component TaskListItem inherits Rectangle {
    in-out property <bool> checked: false;
    in-out property <string> title;
    in-out property <string> time-label;
    callback toggled(bool);
    callback adjust-clicked();

    background: Theme.card-bg;
    border-radius: Theme.border-radius-panel;
    border-width: Theme.stroke-normal;
    border-color: Theme.card-stroke;
    height: 56px;

    HorizontalLayout {
        padding: Theme.padding-normal;
        spacing: Theme.spacing-item;

        checkbox-container := HorizontalLayout {
            horizontal-stretch: 1;
            CustomCheckbox {
                checked: root.checked;
                label: root.title;
                toggled(val) => { root.toggled(val); }
            }
        }

        meta-action-container := HorizontalLayout {
            spacing: Theme.spacing-item;
            
            if (root.time-label != "") : Text {
                text: root.time-label;
                color: Theme.text-sub;
                font-family: Theme.font-family;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
            }

            TouchArea {
                width: 24px;
                height: 24px;
                clicked => { root.adjust-clicked(); }
                Text {
                    text: "⚙️";
                    color: Theme.text-sub;
                    font-size: Theme.font-size-title;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
