import { Theme } from "../../Theme.slint";
import { BentoCard } from "../base/bento_card.slint";
import { CustomInput } from "../base/custom_input.slint";

export component SecretaryCard inherits BentoCard {
    in property <string> advice-text: "本日締切のタスクは2件です。まずUI設計のプロトタイプ確認を優先しましょう。";
    callback create-task(string);
    
    card-fill: Theme.card-bg;
    height: Theme.hero-card-height;
    
    VerticalLayout {
        spacing: Theme.spacing-item;
        alignment: space-between;
        
        HorizontalLayout {
            spacing: Theme.spacing-small;
            
            Text {
                text: "🤖";
                font-family: Theme.font-family;
                font-size: Theme.font-size-title;
            }
            
            Text {
                text: "システム秘書ワンポイント";
                font-family: Theme.font-family;
                font-size: Theme.font-size-body;
                font-weight: 700;
                color: Theme.primary-light;
                vertical-alignment: center;
            }
        }
        
        Text {
            text: root.advice-text;
            font-family: Theme.font-family;
            font-size: Theme.font-size-body;
            color: Theme.text;
            wrap: word-wrap;
        }
        
        CustomInput {
            placeholder: "✨ 自然言語入力: 明日15時 レビューミーティング @仕事 !高";
            prefix-icon: "✨";
            accepted(text) => {
                root.create-task(text);
                self.text = "";
            }
        }
    }
}
