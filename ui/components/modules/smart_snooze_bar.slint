import { Chip } from "../base/chip.slint";
import { Theme } from "../../Theme.slint";
import { ScrollView } from "std-widgets.slint";

export component SmartSnoozeBar inherits Rectangle {
    callback snooze-selected(string);
    in property <bool> visible-snooze: false;

    height: root.visible-snooze ? 40px : 0px;
    opacity: root.visible-snooze ? 1.0 : 0.0;
    background: transparent;

    animate height, opacity { duration: 150ms; }

    ScrollView {
        viewport-width: 480px;
        HorizontalLayout {
            padding: 4px;
            spacing: 8px;
            
            Chip { text: "⏰ 今日の夜 (19:30)"; clicked => { root.snooze-selected("tonight"); } }
            Chip { text: "⏰ 明日の朝 (08:30)"; clicked => { root.snooze-selected("tomorrow-morning"); } }
            Chip { text: "📅 次の週 (月曜)"; clicked => { root.snooze-selected("next-week"); } }
            Chip { text: "✕ 保留する"; clicked => { root.snooze-selected("hold"); } }
        }
    }
}
