import { Theme } from "../../Theme.slint";
import { BindPreviewItem } from "../modules/bind_preview_item.slint";
import { ScrollView } from "std-widgets.slint";
import { CustomButton } from "../base/custom_button.slint";

export component BindPreviewSheetCompact inherits Rectangle {
    callback close-clicked();

    background: Theme.card-bg;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-width: 1px;
    border-color: Theme.border-color;

    VerticalLayout {
        padding: Theme.padding-normal;
        spacing: 12px;

        // Top Drag Handle (Visual indicator)
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 4px;
                background: Theme.border-color;
                border-radius: 2px;
            }
        }

        // Header with title and close button
        HorizontalLayout {
            alignment: space-between;
            
            Text {
                text: "🪄 AI解析プレビュー";
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }
            
            CustomButton {
                text: "✕";
                bg-color: Theme.background;
                hover-color: Theme.border-color;
                clicked => { root.close-clicked(); }
                height: 28px;
            }
        }

        // Scrollable list
        ScrollView {
            viewport-height: 350px;
            VerticalLayout {
                spacing: 12px;
                
                BindPreviewItem {
                    title: "牛乳を買う";
                    time-chip-text: "⏰ 今日の夜 (19:00)";
                    location-chip-text: "📍 スーパー";
                }

                BindPreviewItem {
                    title: "ゴミ出し";
                    time-chip-text: "⏰ 明日の朝 (08:00)";
                    location-chip-text: "📍 自宅";
                }
            }
        }
    }
}
