import { Theme } from "../../Theme.slint";

export component RecurrenceConfigCompact inherits Rectangle {
    in property <string> summary-text: "なし";
    callback clicked();

    background: Theme.card-bg;
    border-radius: Theme.border-radius-card;
    border-width: 1px;
    border-color: Theme.border-color;
    height: 52px;

    TouchArea {
        clicked => { root.clicked(); }
        HorizontalLayout {
            padding: Theme.padding-normal;
            spacing: 8px;
            
            Text {
                text: "🔄 繰り返し: " + root.summary-text;
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: 14px;
                vertical-alignment: center;
            }
            
            Rectangle {}

            Text {
                text: "設定変更 ➔";
                color: Theme.text-sub;
                font-family: Theme.font-family;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}
