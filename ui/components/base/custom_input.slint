import { Theme } from "../../Theme.slint";

export component CustomInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "";
    in property <string> prefix-icon: "";
    callback accepted(string);
    callback edited(string);
    
    height: 42px;
    background: #0f121a;
    border-radius: Theme.border-radius-small;
    border-color: input.has-focus ? Theme.primary-light : #1e2638;
    border-width: input.has-focus ? 1.5px : 1px;
    
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        alignment: center;
        
        if root.prefix-icon != "" : Text {
            text: root.prefix-icon;
            font-family: Theme.font-family;
            font-size: 14px;
            color: Theme.primary-light;
            vertical-alignment: center;
        }
        
        Rectangle {
            horizontal-stretch: 1;
            
            if root.text == "" && !input.has-focus : Text {
                text: root.placeholder;
                font-family: Theme.font-family;
                font-size: 13px;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: 100%;
                height: 100%;
            }
            
            input := TextInput {
                font-family: Theme.font-family;
                font-size: 13px;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-alignment: left;
                single-line: true;
                width: 100%;
                height: 100%;
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
            }
        }
    }
}
