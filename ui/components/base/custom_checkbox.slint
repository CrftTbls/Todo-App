import { Theme } from "../../Theme.slint";

export component CustomCheckbox inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);
    
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? #10b98120 : transparent;
    border-color: root.checked ? Theme.success : (touch.has-hover ? Theme.primary-light : Theme.text-muted);
    border-width: 2px;
    
    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    
    if root.checked : Text {
        text: "✓";
        font-family: Theme.font-family;
        font-size: 12px;
        font-weight: 700;
        color: Theme.success;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
