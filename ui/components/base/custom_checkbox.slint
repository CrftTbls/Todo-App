import { Theme } from "../../Theme.slint";

export component CustomCheckbox inherits Rectangle {
    in-out property <bool> checked: false;
    in-out property <string> label;
    callback toggled(bool);

    height: 32px;
    background: transparent;

    ta := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        
        // Checkbox border/fill
        Rectangle {
            width: 20px;
            height: 20px;
            border-width: 2px;
            border-color: root.checked ? Theme.primary : Theme.border-color;
            background: root.checked ? Theme.primary : transparent;
            border-radius: 4px;
            vertical-stretch: 0;
            
            animate background, border-color { duration: 100ms; }

            if (root.checked) : Text {
                text: "✓";
                color: Theme.text;
                font-size: 14px;
                font-weight: 900;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-family: Theme.font-family;
            font-size: 14px;
            vertical-alignment: center;
        }
    }
}
