import { Theme } from "../../Theme.slint";

export component CustomToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label;
    callback toggled(bool);

    height: 32px;
    background: transparent;

    ta := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        
        // Track
        Rectangle {
            width: 44px;
            height: 24px;
            background: root.checked ? Theme.primary : Theme.border-color;
            border-radius: 12px;
            vertical-stretch: 0;
            
            animate background { duration: 150ms; }

            // Thumb
            Rectangle {
                x: root.checked ? 22px : 2px;
                y: 2px;
                width: 20px;
                height: 20px;
                background: Theme.text;
                border-radius: 10px;
                
                animate x { duration: 150ms; }
            }
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-family: Theme.font-family;
            font-size: 14px;
            vertical-alignment: center;
        }
    }
}
