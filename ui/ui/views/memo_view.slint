import { Theme } from "../Theme.slint";
import { Button, TextEdit } from "std-widgets.slint";
import { BindPreviewSheetDetailed } from "../components/configs/bind_preview_sheet_detailed.slint";
import { BindPreviewSheetCompact } from "../components/configs/bind_preview_sheet_compact.slint";

export component MemoView inherits Rectangle {
    in property <bool> is-mobile;
    in-out property <bool> show-mobile-sheet: false;
    
    property <length> avail-width: root.width - (Theme.padding-normal * 2);
    property <length> avail-height: root.height - (Theme.padding-normal * 2);
    
    // Main editor
    editor := TextEdit {
        x: Theme.padding-normal;
        y: Theme.padding-normal;
        width: root.is-mobile ? root.avail-width : (root.avail-width - 20px) * 50%;
        height: root.is-mobile ? (root.avail-height - 50px) : root.avail-height;
        font-family: Theme.font-family;
    }
    
    // Mobile organize button
    if (root.is-mobile) : Button {
        x: Theme.padding-normal;
        y: root.avail-height - 35px;
        width: root.avail-width;
        height: 40px;
        text: "🪄 整理 (AI抽出)";
        clicked => { root.show-mobile-sheet = true; }
    }
    
    // Mobile backdrop scrim
    if (root.is-mobile && root.show-mobile-sheet) : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        
        TouchArea {
            clicked => { root.show-mobile-sheet = false; }
        }
    }
    
    // Desktop preview panel
    if (!root.is-mobile) : BindPreviewSheetDetailed {
        x: Theme.padding-normal + (root.avail-width - 20px) * 50% + 20px;
        y: Theme.padding-normal;
        width: (root.avail-width - 20px) * 50%;
        height: root.avail-height;
    }

    // Mobile bottom sheet
    if (root.is-mobile) : BindPreviewSheetCompact {
        x: 0;
        y: root.show-mobile-sheet ? root.height * 30% : root.height;
        width: root.width;
        height: root.height * 70%;
        close-clicked => { root.show-mobile-sheet = false; }

        animate y { duration: 220ms; easing: ease-out; }
    }
}
