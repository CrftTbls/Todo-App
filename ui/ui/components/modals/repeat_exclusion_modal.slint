import { Theme } from "../../Theme.slint";
import { CustomButton } from "../base/custom_button.slint";
import { CalendarCell } from "../modules/calendar_cell.slint";

export component RepeatExclusionModal inherits Rectangle {
    callback confirm-clicked();
    callback cancel-clicked();
    callback cell-clicked(string);

    background: #00000080;

    TouchArea {
        clicked => { root.cancel-clicked(); }
    }

    Rectangle {
        width: 320px;
        height: 380px;
        background: Theme.card-bg;
        border-radius: Theme.border-radius-card;
        border-width: 1px;
        border-color: Theme.border-color;

        VerticalLayout {
            padding: Theme.padding-normal;
            spacing: 14px;

            Text {
                text: "📅 除外カレンダー設定";
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: "タップして繰り返しから除外する日付を選択してください。";
                color: Theme.text-sub;
                font-family: Theme.font-family;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            GridLayout {
                spacing: 6px;
                
                CalendarCell { row: 0; col: 0; day-text: "10"; clicked => { root.cell-clicked("10"); } }
                CalendarCell { row: 0; col: 1; day-text: "11"; clicked => { root.cell-clicked("11"); } }
                CalendarCell { row: 0; col: 2; day-text: "12"; clicked => { root.cell-clicked("12"); } }
                
                CalendarCell { row: 1; col: 0; day-text: "17"; clicked => { root.cell-clicked("17"); } }
                CalendarCell { row: 1; col: 1; day-text: "18"; selected: true; clicked => { root.cell-clicked("18"); } }
                CalendarCell { row: 1; col: 2; day-text: "19"; clicked => { root.cell-clicked("19"); } }

                CalendarCell { row: 2; col: 0; day-text: "24"; clicked => { root.cell-clicked("24"); } }
                CalendarCell { row: 2; col: 1; day-text: "25"; clicked => { root.cell-clicked("25"); } }
                CalendarCell { row: 2; col: 2; day-text: "26"; clicked => { root.cell-clicked("26"); } }
            }

            Rectangle {}

            HorizontalLayout {
                spacing: 12px;
                
                CustomButton {
                    text: "キャンセル";
                    bg-color: Theme.background;
                    hover-color: Theme.border-color;
                    clicked => { root.cancel-clicked(); }
                    horizontal-stretch: 1;
                }

                CustomButton {
                    text: "保存";
                    bg-color: Theme.primary;
                    hover-color: Theme.primary-hover;
                    clicked => { root.confirm-clicked(); }
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
