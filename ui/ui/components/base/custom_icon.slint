import { Theme } from "../../Theme.slint";

export component CustomIcon inherits Text {
    in property <string> icon-name;
    in property <length> size: 16px;
    in property <color> icon-color: Theme.text;

    text: root.icon-name == "settings" ? "⚙️" 
        : root.icon-name == "calendar" ? "📅"
        : root.icon-name == "check" ? "✓"
        : root.icon-name == "clock" ? "⏰"
        : root.icon-name == "delete" ? "🗑️"
        : root.icon-name == "edit" ? "✏️"
        : root.icon-name == "location" ? "📍"
        : root.icon-name == "add" ? "➕"
        : root.icon-name == "search" ? "🔍"
        : root.icon-name == "arrow-right" ? "➔"
        : root.icon-name == "back" ? "✕"
        : root.icon-name;
    font-size: root.size;
    color: root.icon-color;
    font-family: Theme.font-family;
    horizontal-alignment: center;
    vertical-alignment: center;
}
