import { Theme } from "../../Theme.slint";
import { CustomButton } from "../base/custom_button.slint";

export component ActionHeader inherits Rectangle {
    in property <string> title;
    in property <string> left-text: "✕ 戻る";
    in property <string> right-text: "";
    in property <bool> right-visible: false;
    callback left-clicked();
    callback right-clicked();

    height: 48px;
    background: Theme.card-bg;

    HorizontalLayout {
        padding-left: Theme.padding-normal;
        padding-right: Theme.padding-normal;
        spacing: 12px;
        
        left-btn := CustomButton {
            text: root.left-text;
            bg-color: Theme.background;
            hover-color: Theme.border-color;
            clicked => { root.left-clicked(); }
            height: 32px;
        }

        Text {
            text: root.title;
            color: Theme.text;
            font-family: Theme.font-family;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        right-btn := CustomButton {
            text: root.right-text;
            bg-color: Theme.primary;
            hover-color: Theme.primary-hover;
            visible: root.right-visible;
            clicked => { root.right-clicked(); }
            height: 32px;
        }
    }
}
