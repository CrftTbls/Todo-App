export global Theme {
    in-out property <color> primary: #6366f1;       // Indigo blue (Accent)
    in-out property <color> primary-hover: #4f46e5; // Hover color
    in-out property <color> background: #0f172a;    // Deep navy (Background)
    in-out property <color> card-bg: #1e293b;       // Slate gray (Card background)
    in-out property <color> border-color: #334155;  // Slate border
    in-out property <color> text: #f8fafc;          // White text
    in-out property <color> text-sub: #94a3b8;      // Light gray subtext
    
    in-out property <color> success: #10b981;       // Emerald green
    in-out property <color> warning: #f59e0b;       // Amber
    in-out property <color> danger: #ef4444;        // Rose red
    
    in-out property <string> font-family: "Segoe UI, Malgun Gothic, Yu Gothic, system-ui, sans-serif";
    
    in-out property <length> mobile-width-breakpoint: 680px;
    in-out property <length> tablet-width-breakpoint: 1000px;
    in-out property <length> compact-height-breakpoint: 600px;
    in-out property <length> padding-normal: 16px;
    in-out property <length> border-radius-card: 12px;
}
