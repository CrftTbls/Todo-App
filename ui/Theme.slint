export global Theme {
    // Simple Dark Theme Palette
    in-out property <color> background: #0d1117;        // Main background (#0D1117)
    in-out property <color> sidebar-bg: #161b22;        // Sidebar background (#161B22)
    in-out property <color> card-bg: #161b22;           // Bento card fill (#161B22)
    in-out property <color> card-bg-hover: #21262d;     // Bento card hover fill (#21262D)
    in-out property <color> card-stroke: #30363d;       // Bento card border stroke (#30363D)
    in-out property <color> card-stroke-highlight: #1f6feb; // Active border stroke (#1F6FEB)
    
    // Sub-panel Container Fill Colors
    in-out property <color> panel-bg-dark: #0d1117;     // Dark inner container
    in-out property <color> panel-bg: #161b22;          // Standard inner container
    in-out property <color> panel-bg-sub: #222d3d;       // Alternate item container (#222D3D)
    
    // Accent & Alpha Colors
    in-out property <color> primary: #1f6feb;          // GitHub Blue primary accent (#1F6FEB)
    in-out property <color> primary-light: #58a6ff;    // Light text/accent (#58A6FF)
    in-out property <color> primary-hover: #388bfd;    // Hover state
    in-out property <color> primary-alpha: #1f6feb20;   // Soft blue highlight
    in-out property <color> primary-border-alpha: #1f6feb50; // Blue border highlight
    
    in-out property <color> text: #e6edf2;             // Primary white text (#E6EDF2)
    in-out property <color> text-sub: #8b949e;         // Subtext gray (#8B949E)
    in-out property <color> text-muted: #6e7681;       // Muted gray
    
    // Status & Alpha Colors
    in-out property <color> success: #238636;          // GitHub green (#238636)
    in-out property <color> success-alpha: #23863620;   // Soft green highlight
    in-out property <color> warning: #d29922;          // Amber
    in-out property <color> danger: #f85149;           // Rose red
    in-out property <color> danger-light: #ff7b72;     // Rose red text
    
    // Typography
    in-out property <string> font-family: "Segoe UI, Malgun Gothic, Yu Gothic, system-ui, sans-serif";
    in-out property <length> font-size-header: 24px;
    in-out property <length> font-size-title: 16px;
    in-out property <length> font-size-body: 14px;
    in-out property <length> font-size-small: 12px;
    
    // Layout Dimensions & Controls
    in-out property <length> sidebar-width: 240px;
    in-out property <length> window-min-width: 1024px;
    in-out property <length> window-min-height: 720px;
    in-out property <length> window-pref-width: 1440px;
    in-out property <length> window-pref-height: 900px;
    
    // Fixed Component Heights
    in-out property <length> header-height: 48px;
    in-out property <length> hero-card-height: 180px;
    in-out property <length> summary-card-height: 160px;
    in-out property <length> button-height-normal: 36px;
    in-out property <length> button-height-small: 32px;
    in-out property <length> input-height-normal: 40px;
    
    // Spacing (Gaps)
    in-out property <length> spacing-view: 24px;
    in-out property <length> spacing-card: 16px;
    in-out property <length> spacing-panel: 14px;
    in-out property <length> spacing-item: 12px;
    in-out property <length> spacing-small: 8px;
    
    // Padding
    in-out property <length> padding-workspace: 32px;
    in-out property <length> padding-card: 20px;
    in-out property <length> padding-panel: 14px;
    in-out property <length> padding-item: 12px;
    in-out property <length> padding-compact: 8px;
    in-out property <length> padding-small: 8px;
    in-out property <length> padding-normal: 16px;
    in-out property <length> padding-large: 24px;
    
    // Border Radius & Stroke
    in-out property <length> border-radius-card: 6px;
    in-out property <length> border-radius-panel: 6px;
    in-out property <length> border-radius-small: 4px;
    in-out property <length> border-radius-badge: 4px;
    in-out property <length> stroke-normal: 1px;
    in-out property <length> stroke-bold: 1.5px;
}
