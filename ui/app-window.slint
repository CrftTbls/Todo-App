import { Theme } from "Theme.slint";
import { SlintTask } from "types.slint";
export { SlintTask }

// Base Custom Components & Shell
import { BaseView } from "components/base/base_view.slint";
import { CustomButton } from "components/base/custom_button.slint";

// Modals
import { TaskDetailModal } from "components/modals/task_detail_modal.slint";

// Views
import { BentoDashboardView } from "views/bento_dashboard_view.slint";
import { WbsChainView } from "views/wbs_chain_view.slint";
import { MemoStockView } from "views/memo_stock_view.slint";
import { CalendarScheduleView } from "views/calendar_schedule_view.slint";
import { SettingsSyncView } from "views/settings_sync_view.slint";

export component AppWindow inherits Window {
    title: "Secretarial Todo - Bento Dashboard";
    background: Theme.background;
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;
    preferred-width: Theme.window-pref-width;
    preferred-height: Theme.window-pref-height;
    
    in-out property <string> current-view: "dashboard"; // "dashboard" | "wbs" | "memo" | "calendar" | "settings"
    in-out property <bool> show-task-detail-modal: false;
    
    in-out property <[SlintTask]> today-tasks: [
        { id: "1", title: "デスクトップUIのPencil再設計とプロトタイピング", status: "todo", priority: "high", due_date: "23:59 まで", parent_id: "", chain_id: "", chain_order: 0 },
        { id: "2", title: "Rustバックエンド状態非同期整理", status: "todo", priority: "medium", due_date: "18:00 まで", parent_id: "", chain_id: "", chain_order: 0 }
    ];
    in-out property <[SlintTask]> upcoming-tasks: [
        { id: "3", title: "ローカルSQLiteデータベースのインデックス最適化", status: "todo", priority: "low", due_date: "8月5日", parent_id: "", chain_id: "", chain_order: 0 }
    ];
    in-out property <[SlintTask]> done-tasks: [
        { id: "4", title: "チュートリアル画面テキスト確認", status: "done", priority: "none", due_date: "", parent_id: "", chain_id: "", chain_order: 0 }
    ];
    
    callback load-tasks();
    callback create-task(string);
    callback update-task-status(string, string);
    callback delete-task(string);

    // BaseView 一体型基本シェルの使用
    BaseView {
        current-view: root.current-view;
        dashboard-badge: "\{root.today-tasks.length}";
        nav-changed(view) => { root.current-view = view; }

        if (root.current-view == "dashboard") : BentoDashboardView {
            today-tasks: root.today-tasks;
            upcoming-tasks: root.upcoming-tasks;
            done-tasks: root.done-tasks;
            create-task(text) => { root.create-task(text); }
            toggle-task-status(id, status) => { root.update-task-status(id, status); }
            select-task(id) => { root.show-task-detail-modal = true; }
        }
        if (root.current-view == "wbs") : WbsChainView {}
        if (root.current-view == "memo") : MemoStockView {}
        if (root.current-view == "calendar") : CalendarScheduleView {}
        if (root.current-view == "settings") : SettingsSyncView {}
    }
    
    // Full Task Detail Modal Overlay (D6)
    if (root.show-task-detail-modal) : TaskDetailModal {
        task-title: "デスクトップUIのPencil再設計とプロトタイピング";
        task-status: "todo";
        task-priority: "high";
        due-date: "2026-08-01 23:59";
        close => { root.show-task-detail-modal = false; }
        save-task(status, priority, due) => {
            root.show-task-detail-modal = false;
        }
    }
}
